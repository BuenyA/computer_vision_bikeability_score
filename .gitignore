# --- Virtuelle Umgebungen (nicht einchecken, plattformabhängig) ---
.venv/
venv/
env/
ENV/

# --- Python-Artefakte ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Modelle / Gewichte / Videos (große Dateien) ---
*.engine
*.pt
*.onnx
*.mp4
*.MP4
*.mov
*.MOV

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Frames: nur beispiel_dji_0390 einchecken, alle anderen ignorieren ---
dataset/frames/*
!dataset/frames/beispiel_dji_0390/
!dataset/frames/beispiel_dji_0390/**
dataset/frames/beispiel_dji_0390/zeroshot/

# --- Test-Set Bilder (generiert von environment_model/data/build_test_dataset.py) ---
dataset/test_images/*
!dataset/test_images/candidates.csv
!dataset/test_images/labels.csv

# --- Externe Datensaetze (grosse Downloads: Mapillary ~25 GB, ADE20K ~1 GB) ---
dataset/external/

# --- Finetune-Experimente (temporäre Trainer-Ausgaben) ---
models/_tmp_experiments/

# --- Trainierte Modell-Gewichte (groß, reproduzierbar via seg_finetune.ipynb) ---
models/segformer_env/model.safetensors

# --- Trainingsbilder-Ordner (Symlinks/Kopien, generiert von organize_training_images.py) ---
dataset/training/*
!dataset/training/manifest.csv
